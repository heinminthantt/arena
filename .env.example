# CyberShield Arena: live API settings (template)
# 1) For local testing: copy this file to ".env.local" and fill in the key.
# 2) For the live site: paste these same three variables into
#    Vercel > arena project > Settings > Environment Variables (Production).
# NEVER commit a filled-in copy, and never paste the real key into chat.

ANTHROPIC_BASE_URL=https://api.nghimmo.com
ANTHROPIC_API_KEY=sk-paste-your-key-here
CLAUDE_MODEL=nghi/claude-sonnet-5.5
